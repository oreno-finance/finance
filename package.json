{
  "name": "finance-importer-starter",
  "version": "2.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build:meta": "node scripts/stamp-app-meta.mjs",
    "build:releases": "node scripts/build-release-notes.mjs",
    "build:styles": "node scripts/build-styles.mjs",
    "build": "npm run build:releases && npm run build:meta && npm run build:styles && node scripts/clean-dist.mjs && tsc && node scripts/copy-static.mjs && node scripts/build-msal.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify:cloud": "node scripts/check-cloud-asset.mjs",
    "audit:staged": "node scripts/audit-publication.mjs --staged",
    "audit:tree": "node scripts/audit-publication.mjs --tree"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438",
    "@azure/msal-browser": "5.30.0"
  }
}
