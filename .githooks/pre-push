#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if [ "$(git config --get core.hooksPath || true)" != '.githooks' ]; then
  echo '[FINANCE] BLOCKED: core.hooksPathが.githooksではありません' >&2
  exit 1
fi
if ! command -v gitleaks >/dev/null 2>&1; then
  echo '[FINANCE] BLOCKED: Gitleaksが未インストールです。brew install gitleaks を実行してください。' >&2
  exit 1
fi
# Inspect only the actual outgoing commits; --tree remains an explicit diagnostic.
node scripts/audit-publication.mjs --push "${2:-}"
